{
	"schemaVersion": 1,
	"id": "ultracapsuleadventure",
	"version": "${version}",
	"name": "울트라 캡슐 어드벤처",
	"description": "길들인 동물/몹을 캡슐에 보관하고 소환하는 보관 캡슐 모드 (MC 26.3 대응)",
	"authors": [
		"You"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/UltraCapsuleAdventure/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ultracapsuleadventure.UltraCapsuleAdventureMod"
		],
		"client": [
			"com.ultracapsuleadventure.client.UltraCapsuleAdventureClient"
		]
	},
	"mixins": [
		"ultracapsuleadventure.mixins.json",
		{
			"config": "ultracapsuleadventure.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "ultracapsuleadventure.client.morph.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}


